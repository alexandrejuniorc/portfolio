{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && node scripts/sitemap.mjs",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist/client",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "pnpm build && pnpm verify:build && pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-start": "^1.168.61",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@inlang/paraglide-js": "^2.27.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
